# Neon Postgres, pooled connection string
DATABASE_URL=
# Deepgram key with at least the Member role (needed to mint browser tokens)
DEEPGRAM_API_KEY=
# Optional. OpenAI writes the practice report (gpt-4.1-mini); a simpler built-in scorer is used without it
OPENAI_API_KEY=
# Random 32-byte hex string used to sign the session cookie: openssl rand -hex 32
SESSION_SECRET=
